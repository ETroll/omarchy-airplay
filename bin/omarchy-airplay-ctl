#!/usr/bin/env bash

set -euo pipefail

config_home="${XDG_CONFIG_HOME:-${HOME}/.config}"
state_dir="${config_home}/omarchy-airplay"
target_file="${state_dir}/target.tsv"
credentials_file="${config_home}/doubletake/credentials.json"

usage() {
  printf 'Usage: %s discover|load|save NAME ADDRESS [DEVICE_ID]|clear|paired DEVICE_ID|forget DEVICE_ID\n' "$0" >&2
  exit 2
}

discover() {
  command -v avahi-browse >/dev/null 2>&1 || {
    printf 'avahi-browse is required (package: avahi)\n' >&2
    exit 127
  }

  # avahi-browse parsable resolved records are semicolon-separated. Prefer
  # IPv4 because DoubleTake and receiver firewall rules are easiest to make
  # predictable with a concrete IPv4 address. De-duplicate by address.
  avahi-browse --resolve --terminate --parsable _airplay._tcp 2>/dev/null |
    awk -F';' '
      function unescape(value, result, code) {
        result = ""
        while (match(value, /\\[0-9][0-9][0-9]/)) {
          result = result substr(value, 1, RSTART - 1)
          code = substr(value, RSTART + 1, 3) + 0
          result = result sprintf("%c", code)
          value = substr(value, RSTART + 4)
        }
        return result value
      }
      $1 == "=" && $3 == "IPv4" && !seen[$8]++ {
        name = unescape($4)
        device_id = ""
        if (match($10, /deviceid=[0-9A-Fa-f:]+/))
          device_id = substr($10, RSTART + 9, RLENGTH - 9)
        print name "\t" $8 "\t" device_id
      }
    '
}

load_target() {
  if [[ -f "$target_file" ]]; then
    head -n 1 "$target_file"
  fi
}

save_target() {
  [[ $# -eq 2 || $# -eq 3 ]] || usage
  local name="$1"
  local address="$2"
  local device_id="${3:-}"

  [[ -n "$name" && -n "$address" ]] || usage
  [[ "$name" != *$'\t'* && "$name" != *$'\n'* ]] || {
    printf 'Receiver name contains unsupported whitespace\n' >&2
    exit 2
  }
  [[ "$address" =~ ^[A-Za-z0-9._:-]+$ ]] || {
    printf 'Invalid receiver address\n' >&2
    exit 2
  }

  mkdir -p "$state_dir"
  umask 077
  local temporary
  temporary="$(mktemp "${state_dir}/target.XXXXXX")"
  printf '%s\t%s\t%s\n' "$name" "$address" "$device_id" >"$temporary"
  mv "$temporary" "$target_file"
}

paired() {
  [[ $# -eq 1 ]] || usage
  [[ -f "$credentials_file" ]] || exit 1
  jq -e --arg device_id "$1" 'has($device_id)' "$credentials_file" >/dev/null
}

forget() {
  [[ $# -eq 1 ]] || usage
  [[ -f "$credentials_file" ]] || exit 0
  command -v jq >/dev/null 2>&1 || {
    printf 'jq is required to forget a receiver pairing\n' >&2
    exit 127
  }

  local temporary
  temporary="$(mktemp "${credentials_file}.XXXXXX")"
  jq --arg device_id "$1" 'del(.[$device_id])' "$credentials_file" >"$temporary"
  chmod 600 "$temporary"
  mv "$temporary" "$credentials_file"
}

case "${1:-}" in
  discover)
    [[ $# -eq 1 ]] || usage
    discover
    ;;
  load)
    [[ $# -eq 1 ]] || usage
    load_target
    ;;
  save)
    shift
    save_target "$@"
    ;;
  clear)
    [[ $# -eq 1 ]] || usage
    if [[ -f "$target_file" ]]; then
      rm -- "$target_file"
    fi
    ;;
  paired)
    shift
    paired "$@"
    ;;
  forget)
    shift
    forget "$@"
    ;;
  *)
    usage
    ;;
esac
